<UserControl x:Class="Deadbelt.Desktop.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="DOP Doctor"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.TextPrimary}"/>
      <TextBlock Text="Assess a local DayZ server installation without executing or modifying it."
                 FontSize="15"
                 Foreground="{StaticResource Brush.TextSecondary}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Environment"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                  ItemsSource="{Binding Environments}"
                  SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  Height="32"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="DayZ server root"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   VerticalAlignment="Center"
                   Margin="0,12,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding TargetRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Height="32"
                 Margin="0,12,8,0"
                 Padding="8,4"/>
        <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                Content="Browse"
                Command="{Binding BrowseTargetRootCommand}"
                Style="{StaticResource SecondaryButton}"
                Width="88"
                Height="32"
                Margin="0,12,0,0"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Startup (.bat/.cmd/.ps1)"
                   ToolTip="Startup scripts are statically parsed and never executed."
                   Foreground="{StaticResource Brush.TextSecondary}"
                   VerticalAlignment="Center"
                   Margin="0,12,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding StartupFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Height="32"
                 Margin="0,12,8,0"
                 Padding="8,4"/>
        <Button Grid.Row="2" Grid.Column="2"
                Content="Browse"
                Command="{Binding BrowseStartupFileCommand}"
                Style="{StaticResource SecondaryButton}"
                Width="88"
                Height="32"
                Margin="0,12,8,0"/>
        <Button Grid.Row="2" Grid.Column="3"
                Content="Clear"
                Command="{Binding ClearStartupFileCommand}"
                Style="{StaticResource SecondaryButton}"
                Width="72"
                Height="32"
                Margin="0,12,0,0"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Config override (optional)"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   VerticalAlignment="Center"
                   Margin="0,12,0,0"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding ConfigurationFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Height="32"
                 Margin="0,12,8,0"
                 Padding="8,4"/>
        <Button Grid.Row="3" Grid.Column="2"
                Content="Browse"
                Command="{Binding BrowseConfigurationFileCommand}"
                Style="{StaticResource SecondaryButton}"
                Width="88"
                Height="32"
                Margin="0,12,8,0"/>
        <Button Grid.Row="3" Grid.Column="3"
                Content="Clear"
                Command="{Binding ClearConfigurationFileCommand}"
                Style="{StaticResource SecondaryButton}"
                Width="72"
                Height="32"
                Margin="0,12,0,0"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
          <Button Content="Cancel"
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource SecondaryButton}"
                  Width="90"
                  Margin="0,0,8,0"/>
          <Button Content="Run Scan"
                  Command="{Binding ScanCommand}"
                  Style="{StaticResource PrimaryButton}"
                  Width="110"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ScanStatus, StringFormat=Status: {0}}"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="16,0"/>
        <TextBlock Grid.Column="2"
                   Text="{Binding ErrorCount, StringFormat=Errors: {0}}"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="8,0"/>
        <TextBlock Grid.Column="3"
                   Text="{Binding WarningCount, StringFormat=Warnings: {0}}"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="8,0"/>
        <TextBlock Grid.Column="4"
                   Text="{Binding Duration, StringFormat=Duration: {0}}"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="16,0,0,0"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox x:Name="DoctorFindingsList"
               Grid.Column="0"
               ItemsSource="{Binding Findings}"
               Background="Transparent"
               BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           FontSize="16"/>
                <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Code, StringFormat=Code: {0}}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Explanation}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Evidence, StringFormat=Evidence: {0}}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Recommendation, StringFormat=Next action: {0}}"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SourcePath}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Column="0"
                 Text="No findings to display. Run a scan to assess the selected target."
                 Foreground="{StaticResource Brush.TextMuted}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="24">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=DoctorFindingsList, Path=HasItems}"
                           Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <Border Grid.Column="2"
              Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Inventory summary"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{Binding InventorySummary}"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Inventory will appear after a completed scan."
                       Foreground="{StaticResource Brush.TextMuted}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InventorySummary}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding InformationCount, StringFormat=Information findings: {0}}"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
